{
  "compilerOptions": {
    "emitDecoratorMetadata":true,
    "experimentalDecorators": true,
    "useDefineForClassFields": false,
    "module": "ESNext",
    "target": "ESNext",
    "jsx": "react",
    "moduleResolution": "node",
    "allowSyntheticDefaultImports": true,
    "lib": ["ES2017", "DOM", "DOM.Iterable"],
    "typeRoots": [ "./node_modules/@types", "../../node_modules/@types", "./node_modules/@webgpu/types"],
    "allowJs": true,
    "noUnusedLocals": true,
    "noImplicitReturns": true,
    "noImplicitThis": true,
    "noImplicitAny": true,
    "skipLibCheck": true,
  },
  "include": ["src"],
}
