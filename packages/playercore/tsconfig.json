{
    "compilerOptions": {
        "allowJs": true,
        "checkJs": false,
        "noEmit": true,
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "target": "ES2018",
        "useDefineForClassFields": false,
        "isolatedModules": true,
        "esModuleInterop": true,
        "allowImportingTsExtensions": true,
        "skipLibCheck": true,
        "types": ["vite/client", "node"],
        "lib": ["DOM", "ESNext", "WebWorker"]
    },
    "include": [
        "./src/**/*"
    ]
}
